#!/bin/bash

# Installs doubletake from the AUR, whose package ships the daemon's user unit,
# then installs and enables this plugin. The daemon itself stays off until it is switched on in the panel.
#
# A copy rather than a symlink on purpose: the shell watches the plugin
# directory with `inotifywait -r`, which does not descend into symlinked
# directories, so a symlinked plugin would install fine and then never
# hot-reload. Re-run this after editing; the copy itself triggers the reload.

set -euo pipefail

PLUGIN_ID="renuo.doubletake"
SOURCE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TARGET_DIR="$HOME/.config/omarchy/plugins/$PLUGIN_ID"
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"

fail() {
  echo "install: $*" >&2
  exit 1
}

packaged() {
  pacman -Q doubletake >/dev/null 2>&1
}

# Earlier installs wrote their own unit with the binary's absolute path. It
# shadows the package's unit, so it goes, and the panel's switch keeps its state.
remove_unit_of_earlier_install() {
  local unit=$UNIT_DIR/doubletake.service enabled=false
  grep -qx 'Description=doubletake AirPlay mirroring daemon' "$unit" 2>/dev/null || return 0
  systemctl --user is-enabled --quiet doubletake.service 2>/dev/null && enabled=true
  systemctl --user disable doubletake.service >/dev/null 2>&1 || true
  rm "$unit"
  systemctl --user daemon-reload
  if $enabled; then
    systemctl --user enable doubletake.service
  fi
  echo "removed $unit, the doubletake package ships the unit now"
}

command -v omarchy-plugin-validate >/dev/null 2>&1 ||
  fail "omarchy is not installed (omarchy-plugin-validate not on PATH)"

omarchy-plugin-validate "$SOURCE_DIR" || fail "manifest validation failed"

packaged || omarchy pkg aur add doubletake
packaged || fail "doubletake is not installed"

remove_unit_of_earlier_install
systemctl --user daemon-reload
# Whether it runs is the panel's switch, so only a running daemon is touched,
# to pick up a new binary.
systemctl --user try-restart doubletake.service

mkdir -p "$TARGET_DIR"

if command -v rsync >/dev/null 2>&1; then
  rsync -a --delete \
    --exclude '.*' \
    --exclude 'bin' \
    --exclude 'test' \
    "$SOURCE_DIR"/ "$TARGET_DIR"/
else
  rm -rf "${TARGET_DIR:?}"/*
  for entry in "$SOURCE_DIR"/*; do
    case "${entry##*/}" in
    bin | test) continue ;;
    esac
    cp -r "$entry" "$TARGET_DIR"/
  done
fi

echo "installed $PLUGIN_ID -> $TARGET_DIR"

# rescanPlugins is belt-and-braces: the inotify watcher already picked up the
# copy, but a first install creates the directory the watcher may not be
# watching yet.
if command -v omarchy-shell >/dev/null 2>&1; then
  omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
fi

if omarchy-plugin-list --json 2>/dev/null | jq -e --arg id "$PLUGIN_ID" 'any(.[]; .id == $id and .enabled)' >/dev/null; then
  echo "already enabled"
else
  omarchy plugin enable "$PLUGIN_ID" --section right 2>/dev/null ||
    echo "enable it with: omarchy plugin enable $PLUGIN_ID --section right"
fi
